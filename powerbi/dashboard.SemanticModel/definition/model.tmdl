model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pl-PL
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode","DaxQueryView_Desktop"]

annotation PBI_QueryOrder = ["pr-rce-pln","pr-weather","pr-poze-redoze","_Measures","Measures_Table"]

ref table Dim_Date
ref table Dim_Time
ref table pr-rce-pln
ref table pr-weather
ref table pr-poze-redoze
ref table Measures_Table

ref cultureInfo en-US

