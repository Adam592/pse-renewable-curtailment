model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pl-PL
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["pr-rce-pln","pr-poze-redoze","pr-weather"]

ref table pr-rce-pln
ref table pr-poze-redoze
ref table pr-weather

ref cultureInfo en-US

